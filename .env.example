# Groq API Configuration (Free tier: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Tavily API Configuration (Free 1,000 searches/mo: https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Pipeline Settings
MAX_SEARCH_RESULTS=5
MAX_SUB_QUERIES=3
MAX_RESULTS_PER_SUBQUERY=3

# Model Hyperparameters
TEMPERATURE=0.2
MAX_TOKENS=1024
PLANNER_TEMPERATURE=0.1
PLANNER_MAX_TOKENS=500
SUMMARIZER_TEMPERATURE=0.1
SUMMARIZER_MAX_TOKENS=2048
FACT_CHECKER_TEMPERATURE=0.1
FACT_CHECKER_MAX_TOKENS=2048

# Security & Content Limits (Phase 3)
MAX_QUERY_LENGTH=500
MAX_CONTENT_CHARS_PER_SOURCE=1500

# Database & Authentication (Phase 5)
# If MONGODB_URI is left blank, the app runs in in-memory mongomock mode for testing/local CLI
MONGODB_URI=
MONGODB_DB_NAME=research_assistant
# Secret used for signing JWT tokens. If left blank, a secure random key is generated automatically on startup.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting & User Quotas (Phase 6)
DAILY_QUERY_LIMIT=10
REQUESTS_PER_MINUTE_LIMIT=3
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Email & Password Reset Settings
# Resend API Key (https://resend.com/). If left empty, email reset will log to console / fallback mock mode.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_LIMIT_PER_HOUR=3


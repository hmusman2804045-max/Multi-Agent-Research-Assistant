# ==============================================================================
# 🤖 MULTI-AGENT RESEARCH ASSISTANT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Fill in your API keys below or copy this file to `.env` (`cp .env.example .env`).
# 2. Never commit your live `.env` file with secret keys to git.

# ------------------------------------------------------------------------------
# 1. GROQ API (Required for Agent LLM Reasoning)
# Free Tier: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 2. TAVILY SEARCH API (Required for Live Web Research)
# Free 1,000 Searches/Month: https://tavily.com/
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 3. MONGODB ATLAS DATABASE (Optional — Persistent User Accounts & History)
# Free M0 Cluster: https://www.mongodb.com/cloud/atlas/register
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# (If left blank, system automatically uses in-memory MongoMock)
# ------------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=research_assistant

# ------------------------------------------------------------------------------
# 4. JWT CRYPTOGRAPHIC AUTHENTICATION (Optional)
# (If left blank, a secure random key is auto-generated on startup)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 5. RESEND TRANSACTIONAL EMAIL (Optional — Password Reset Delivery)
# Free 3,000 Emails/Month: https://resend.com/
# Format: re_...
# (If left blank, system runs in dev mode and prints reset link to console)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_LIMIT_PER_HOUR=3
PASSWORD_RESET_TIMING_FLOOR_SECONDS=0.35

# ------------------------------------------------------------------------------
# 6. PIPELINE, SECURITY & RATE LIMIT SETTINGS
# ------------------------------------------------------------------------------
DAILY_QUERY_LIMIT=10
REQUESTS_PER_MINUTE_LIMIT=3
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

MAX_SEARCH_RESULTS=5
MAX_SUB_QUERIES=3
MAX_RESULTS_PER_SUBQUERY=3
MAX_QUERY_LENGTH=500
MAX_CONTENT_CHARS_PER_SOURCE=1500

TEMPERATURE=0.2
MAX_TOKENS=1024
PLANNER_TEMPERATURE=0.1
PLANNER_MAX_TOKENS=500
SUMMARIZER_TEMPERATURE=0.1
SUMMARIZER_MAX_TOKENS=2048
FACT_CHECKER_TEMPERATURE=0.1
FACT_CHECKER_MAX_TOKENS=2048

# ------------------------------------------------------------------------------
# 7. WEB API & FRONTEND (Phase 7)
# ------------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Only needed when the frontend is served from a DIFFERENT origin than the API
# (e.g. the Vite dev server on :5173). In production both are served together
# from one origin, so this can be left at the default or emptied entirely.
# Use "*" to allow any origin.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bind address and port for the API server. 7860 is what Hugging Face Spaces expects.
API_HOST=0.0.0.0
API_PORT=7860

# Where the built React frontend lives, relative to the project root.
# If this directory has no index.html, the server runs API-only.
FRONTEND_DIST_DIR=frontend/dist

# Public base URL of the deployed app, used to build clickable password reset links
# in reset emails (e.g. https://your-name-research-assistant.hf.space).
# Leave blank to keep the original CLI-form instruction in the email.
PASSWORD_RESET_LINK_BASE_URL=

# Service-wide shared daily cap across ALL users. This is separate from and in
# addition to DAILY_QUERY_LIMIT, which is per-user. Set to 0 to disable.
GLOBAL_DAILY_QUERY_LIMIT=100

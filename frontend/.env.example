# Frontend build-time configuration (Vite). Copy to `.env.local` to override.
#
# Where the browser should send API requests. The default '/api' is a same-origin
# path, which works both in production (FastAPI serves the SPA and the API together)
# and in development (the Vite dev server proxies /api to the backend).
# Only set an absolute URL if you deliberately host the frontend and API separately —
# in that case add the frontend's origin to CORS_ALLOW_ORIGINS in the backend .env.
VITE_API_BASE_URL=/api

# Where `npm run dev` proxies /api to. Change if the API runs on another port.
VITE_API_PROXY_TARGET=http://127.0.0.1:7860
